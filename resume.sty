%==============================================================================
% resume.sty
% Modern ATS-Friendly Resume Style
% Author: Rumal Gunawardana
%==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}[2026/09/27 ATS-Friendly Resume]

%------------------------------------------------------------------------------
% Packages
%------------------------------------------------------------------------------

\RequirePackage[left=0.65in,
                right=0.65in,
                top=0.50in,
                bottom=0.50in]{geometry}

% Improve searchable/copyable text in generated PDFs for ATS parsing.
\RequirePackage{cmap}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

\IfFileExists{glyphtounicode.tex}{%
  \input{glyphtounicode}%
  \ifdefined\pdfgentounicode
    \pdfgentounicode=1
  \fi
}{}

\RequirePackage{lmodern}
\RequirePackage{hyperref}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{setspace}
\RequirePackage{needspace}

%------------------------------------------------------------------------------
% Colors
%------------------------------------------------------------------------------

\definecolor{primary}{HTML}{0057B8}
\definecolor{text}{HTML}{222222}
\definecolor{subtext}{HTML}{666666}
\definecolor{line}{HTML}{D9D9D9}

\color{text}

%------------------------------------------------------------------------------
% Hyperlinks and PDF metadata
%------------------------------------------------------------------------------

\hypersetup{
colorlinks=true,
urlcolor=primary,
linkcolor=primary,
citecolor=primary,
pdfauthor={Rumal Gunawardana},
pdftitle={Rumal Gunawardana - DevOps Engineer CV},
pdfsubject={DevOps, Linux, Telecom Infrastructure, Erlang, Containers},
pdfkeywords={DevOps Engineer, Linux, RHEL, Erlang, Docker, Podman, Kubernetes, SMS Firewall, SS7, MAP, M3UA, SCTP, MariaDB, Redis}
}

\urlstyle{same}

%------------------------------------------------------------------------------
% General Formatting
%------------------------------------------------------------------------------

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.16em}
% Give TeX a little extra flexibility before allowing text to overflow the margin.
\setlength{\emergencystretch}{1.5em}
\linespread{1.00}
\pagestyle{empty}

%------------------------------------------------------------------------------
% Section Formatting
%------------------------------------------------------------------------------

\titleformat{\section}
{\Large\bfseries\color{primary}}
{}
{0em}
{}

\titlespacing{\section}
{0pt}
{10pt}
{5pt}

%------------------------------------------------------------------------------
% Lists
%------------------------------------------------------------------------------

\setlist[itemize]{
leftmargin=18pt,
itemsep=0.8pt,
topsep=0.5pt,
parsep=0pt,
partopsep=0pt,
before=\interlinepenalty10000
}

%------------------------------------------------------------------------------
% Commands
%------------------------------------------------------------------------------

\newcommand{\resumeSection}[1]
{
\vspace{0.22cm}
{\Large\bfseries\color{primary} #1}
\vspace{0.06cm}
\hrule
\vspace{0.10cm}
}

\newcommand{\resumeSubheading}[4]
{
\Needspace{4\baselineskip}
\textbf{\large #1}\hfill{\small #2}\par
\vspace{0.5pt}
{\textit{#3}}\hfill{\small #4}\par
\vspace{1.5pt}
}

\newcommand{\skillCategory}[2]
{
\noindent\textbf{#1}\hspace{0.5em}#2\par
\vspace{1.5pt}
}

\newcommand{\projectHeading}[2]
{
\Needspace{3\baselineskip}
\textbf{#1}\hfill{\small #2}\par
\vspace{1pt}
}

\newcommand{\educationHeading}[3]
{
\textbf{#1}\hfill{\small #2}\par
#3\par
\vspace{2pt}
}

\newcommand{\certification}[1]
{
$\bullet$ #1
\vspace{3pt}
}

\newcommand{\divider}
{
\vspace{0.15cm}
\hrule
\vspace{0.20cm}
}